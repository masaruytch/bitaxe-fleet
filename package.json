{
  "name": "bitaxe-fleet",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev:api": "node node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "dev:web": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "collect": "node node_modules/tsx/dist/cli.mjs src/collector-cli.ts --once",
    "collector": "node node_modules/tsx/dist/cli.mjs src/collector-cli.ts",
    "build": "node scripts/clean-build.mjs && node node_modules/typescript/bin/tsc -p tsconfig.server.json && node node_modules/vite/bin/vite.js build",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.web.json",
    "start": "node dist/src/server.js",
    "start:collector": "node dist/src/collector-cli.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check src shared web tests scripts *.ts *.json *.yaml *.md .github/**/*.yml",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src shared web tests scripts *.ts *.json *.yaml *.md .github/**/*.yml",
    "notices": "node scripts/third-party-notices.mjs && node node_modules/prettier/bin/prettier.cjs --write THIRD_PARTY_NOTICES.md",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "demo": "node dist/src/demo-cli.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.104.5",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "8.5.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "description": "Local fleet monitoring for Bitaxe miners running AxeOS",
  "license": "MIT"
}
