# Set these as process environment variables; the app does not auto-load .env.
# Default local database lives outside the repository.
# DATABASE_PATH=/absolute/local/path/dashboard.sqlite
HOST=127.0.0.1
PORT=3080
POLL_INTERVAL_SECONDS=30
MINER_TIMEOUT_MS=5000
RETENTION_DAYS=1

# Browser origin allowed to update inventory and dashboard settings (use port 5173 with Vite development).
APP_ORIGIN=http://127.0.0.1:3080

# Optional read-only demo, with a separate default database and port 3081.
# DEMO_MODE=1

# Optional separate fleet created from the demo wizard.
# FLEET_PORT=3082
# FLEET_DATABASE_PATH=/absolute/local/path/fleet.sqlite
